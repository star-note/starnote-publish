{
  "name": "@starnote/publish-github",
  "version": "1.0.1",
  "description": "辰记发布Github SDK",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "build:web": "webpack --config ./webpack.config.js",
    "build:node": "webpack --config ./webpack.config.node.js",
    "build": "pnpm build:web & pnpm build:node"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/star-note/starnote-publish.git"
  },
  "author": "辰记ludejun <ludejun@live.cn> (https://github.com/star-note/starnote-publish)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/star-note/starnote-publish/issues"
  },
  "keywords": [],
  "homepage": "https://github.com/star-note/starnote-publish",
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@babel/cli": "^7.21.5",
    "@babel/core": "^7.21.8",
    "@babel/preset-env": "^7.21.5",
    "@babel/preset-typescript": "^7.21.5",
    "babel-loader": "^9.1.2",
    "clean-webpack-plugin": "^4.0.0",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "@repo/global": "workspace:*",
    "@octokit/rest": "^18.12.0",
    "js-base64": "^3.7.2"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ],
  "prettier": {
    "overrides": [
      {
        "files": [
          ".prettierrc",
          ".eslintrc"
        ],
        "options": {
          "parser": "json"
        }
      }
    ],
    "singleQuote": true
  },
  "private": false,
  "sideEffects": false,
  "main": "lib/index.js",
  "directories": {
    "lib": "dist"
  }
}
