{
  "name": "@starnote/publish-chenji",
  "version": "0.1.0",
  "description": "StarNote publish adapter for 辰记 (chenji): posts the converted document to the StarNote API.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../../.. packages/adapters/chenji"
  },
  "dependencies": {
    "@starnote/publish-core": "workspace:*"
  },
  "peerDependencies": {
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "zod": "^4.1.0"
  },
  "license": "UNLICENSED"
}
