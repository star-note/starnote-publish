{
  "name": "@starnote/publish-juejin",
  "version": "0.1.0",
  "description": "StarNote publish adapter for 掘金: desktop login session (persist:pub-juejin-<accountId>), driven by a signed site script.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./electron": {
      "types": "./dist/electron.d.ts",
      "import": "./dist/electron.js",
      "default": "./dist/electron.js"
    },
    "./site-script.signed.json": "./dist/site-script.signed.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && cp src/site-script.signed.json dist/",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../../.. packages/adapters/juejin"
  },
  "dependencies": {
    "@starnote/publish-core": "workspace:*"
  },
  "peerDependencies": {
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "zod": "^4.1.0"
  },
  "license": "UNLICENSED"
}
